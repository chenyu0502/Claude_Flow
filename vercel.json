{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/interior", "destination": "/interior/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/stock", "destination": "/stock/index.html" },
    { "source": "/stock/(.*)", "destination": "/stock/index.html" },
    { "source": "/interior/", "destination": "/interior/index.html" },
    {
      "source": "/((?!api/|assets/|stock/|interior/|version.json).*)",
      "destination": "/index.html"
    }
  ]
}
