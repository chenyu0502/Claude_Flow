{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/((?!interior-gate\\.js$).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/interior", "destination": "/interior/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/stock", "destination": "https://tw-stock-analysis.vercel.app/stock/index.html" },
    { "source": "/stock/", "destination": "https://tw-stock-analysis.vercel.app/stock/index.html" },
    { "source": "/stock/:path+", "destination": "https://tw-stock-analysis.vercel.app/stock/:path+" },
    { "source": "/api/:path*", "destination": "https://tw-stock-analysis.vercel.app/api/:path*" },
    { "source": "/interior/", "destination": "/interior/index.html" },
    {
      "source": "/((?!api/|assets/|stock/|interior/).*)",
      "destination": "/index.html"
    }
  ]
}
