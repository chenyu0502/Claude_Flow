{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/((?!interior-gate\\.js$)(?!travel-gate\\.js$)(?!animate-gate\\.js$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/interior",
      "destination": "/interior/",
      "permanent": false
    },
    {
      "source": "/travel",
      "destination": "/travel/",
      "permanent": false
    },
    {
      "source": "/animate",
      "destination": "/animate/",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/animate/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/stock",
      "destination": "https://tw-stock-analysis.vercel.app/stock/index.html"
    },
    {
      "source": "/stock/",
      "destination": "https://tw-stock-analysis.vercel.app/stock/index.html"
    },
    {
      "source": "/stock/:path+",
      "destination": "https://tw-stock-analysis.vercel.app/stock/:path+"
    },
    {
      "source": "/api/:path((?!travel/|animate/).*)",
      "destination": "https://tw-stock-analysis.vercel.app/api/:path"
    },
    {
      "source": "/interior/",
      "destination": "/interior/index.html"
    },
    {
      "source": "/travel/",
      "destination": "/travel/index.html"
    },
    {
      "source": "/animate/",
      "destination": "/animate/index.html"
    },
    {
      "source": "/((?!api/|assets/|stock/|interior/|travel/|animate/|version\\.json$).*)",
      "destination": "/index.html"
    }
  ]
}
