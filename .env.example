# 复制为 .env.local 后填写。
# 本地开发：保留 VITE_USE_EMULATOR=true 即可，不需要真的 Firebase 项目（使用 demo-claude-flow）。
# 正式环境：把 VITE_USE_EMULATOR 改为 false，并填入 Firebase Console → 项目设置 → 你的应用 中的配置。
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-claude-flow
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
