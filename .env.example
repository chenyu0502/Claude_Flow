# 複製為 .env.local 後填寫。
# 本機開發：保留 VITE_USE_EMULATOR=true 即可，不需要真的 Firebase 專案（使用 demo-claude-flow）。
# 正式環境：把 VITE_USE_EMULATOR 改為 false，並填入 Firebase Console → 專案設定 → 你的應用程式 中的設定值。
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-claude-flow
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 台股分析的後端 API（api/）用，沒有 VITE_ 前綴，只在伺服器端使用、不會進前端 bundle。
# 都是選填：未設定時對應區塊會顯示提示，其餘功能不受影響。
FINMIND_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
