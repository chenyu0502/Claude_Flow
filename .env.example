# 複製為 .env.local 後填寫。
# 本機開發：保留 VITE_USE_EMULATOR=true 即可，不需要真的 Firebase 專案（使用 demo-claude-flow）。
# 正式環境：把 VITE_USE_EMULATOR 改為 false，並填入 Firebase Console → 專案設定 → 你的應用程式 中的設定值。
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-claude-flow
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 本機連同台股一起開發時，/stock、/api 轉送到台股開發伺服器的網址（選填，預設 http://localhost:5174）。
# 台股的 FINMIND_TOKEN、GEMINI_API_KEY 設在台股 repo 的 .env.local。
STOCK_DEV_URL=
