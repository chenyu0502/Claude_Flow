{
  "name": "claude-flow-auth-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-interior.mjs --dev --if-missing",
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/fetch-interior.mjs && vite build",
    "interior:update": "node scripts/fetch-interior.mjs --dev",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-claude-flow \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-claude-flow"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "date-fns": "^4.4.0",
    "firebase": "^11.0.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "firebase-tools": "^13.25.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
