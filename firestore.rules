rules_version = '2';

// Firestore Security Rules（規格見 CONTRACTS.md「Security Rules 規格」）
// 只開放 users/{uid}、portfolios/{uid}、auditLogs/{logId} 與 handan/{docId}，其他集合一律拒絕。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 只用 Email/密碼登入、還沒驗證信箱的帳號回傳 false，其他一律 true。
    // 與前端 needsEmailVerification、API 的 isUnverifiedPasswordAccount 同一套判斷：
    // identities 裡只有 email（Email/密碼）才需要驗證；GitHub 帳號的 email_verified 常是 false，不能擋。
    function emailVerifiedIfPassword() {
      let ids = request.auth.token.get('firebase', {}).get('identities', {});
      return request.auth.token.get('email_verified', false) == true
        || !('email' in ids)
        || ids.size() > 1;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // admin = 自己的文件 role == 'admin' 且 disabled == false
    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', 'user') == 'admin'
        && get(userPath(request.auth.uid)).data.get('disabled', true) == false;
    }

    // UserProfile 的全部欄位鍵
    function profileKeys() {
      return ['uid', 'email', 'displayName', 'photoURL', 'role', 'disabled',
              'providers', 'createdAt', 'lastLoginAt'];
    }

    // 本人可改的欄位
    function selfEditableKeys() {
      return ['displayName', 'photoURL', 'email', 'providers', 'lastLoginAt'];
    }

    function validDisplayName(v) {
      return v == null || (v is string && v.size() <= 50);
    }

    function validPhotoURL(v) {
      return v == null || (v is string && v.size() <= 2048);
    }

    function validEmail(v) {
      return v == null || (v is string && v.size() <= 320);
    }

    function validProviders(v) {
      return v is list && v.size() <= 3 && v.hasOnly(['google.com', 'github.com', 'password']);
    }

    // 本人可改欄位的值檢查（對寫入後的完整文件檢查）
    function validEditableValues(data) {
      return validDisplayName(data.displayName)
        && validPhotoURL(data.photoURL)
        && validEmail(data.email)
        && validProviders(data.providers);
    }

    function validCreate(userId) {
      let data = request.resource.data;
      return request.auth.uid == userId
        && data.keys().hasOnly(profileKeys())
        && data.keys().hasAll(profileKeys())
        && data.uid == userId
        && data.role == 'user'
        && data.disabled == false
        && validEditableValues(data)
        && data.createdAt == request.time
        && data.lastLoginAt == request.time;
    }

    // 本人更新：未停用；只能改 selfEditableKeys；lastLoginAt 若有變動必須是 serverTimestamp()
    function validSelfUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == userId
        && resource.data.disabled == false
        && changed.hasOnly(selfEditableKeys())
        && validEditableValues(request.resource.data)
        && (!changed.hasAny(['lastLoginAt']) || request.resource.data.lastLoginAt == request.time);
    }

    // admin 更新他人：只能改 role / disabled；不能改自己（自己走 validSelfUpdate，那裡不允許改 role/disabled）
    function validAdminUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid != userId
        && isAdmin()
        && changed.hasOnly(['role', 'disabled'])
        && request.resource.data.role in ['admin', 'user']
        && request.resource.data.disabled is bool;
    }

    match /users/{userId} {
      // 本人可讀自己（即使 disabled）；admin 可讀全部
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && validCreate(userId);
      allow update: if signedIn() && (validSelfUpdate(userId) || validAdminUpdate(userId));
      allow delete: if false;
    }

    // ---- 登入紀錄與操作日誌 auditLogs/{logId} ----
    // 由前端寫入（Spark 方案沒有 Cloud Functions），所以靠規則確保：
    // 只能記自己的事（actorUid／actorEmail 與登入憑證一致）、時間由伺服器決定、寫入後不能改也不能刪。
    // 管理員操作必須和實際的 users 變更寫在同一個批次（getAfter 比對變更後的值），
    // 不能憑空記一筆沒發生的操作。

    function logKeys() {
      return ['type', 'actorUid', 'actorEmail', 'targetUid', 'detail', 'device', 'createdAt'];
    }

    function providerIds() {
      return ['google.com', 'github.com', 'password'];
    }

    // 只記自己帳號的事件：targetUid 必須是 null
    function validSelfLog(d) {
      let t = d.type;
      let detail = d.detail;
      return d.targetUid == null && (
        ((t == 'login' || t == 'register') && detail.keys().hasOnly(['method']) && detail.method in providerIds())
        || ((t == 'logout' || t == 'password_change' || t == 'email_verified') && detail.size() == 0)
        || ((t == 'provider_link' || t == 'provider_unlink')
            && detail.keys().hasOnly(['provider']) && detail.provider in providerIds())
        || (t == 'profile_update' && detail.keys().hasOnly(['fields'])
            && detail.fields is list && detail.fields.size() > 0
            && detail.fields.hasOnly(['displayName', 'photoURL']))
      );
    }

    // 管理員對他人的操作：必須真的在同一批次改了對方的 users 文件
    function validAdminLog(d) {
      let t = d.type;
      let target = d.targetUid;
      return isAdmin()
        && target is string && target != request.auth.uid
        && (
          (t == 'role_change' && d.detail.keys().hasOnly(['role']) && d.detail.role in ['admin', 'user']
            && getAfter(userPath(target)).data.role == d.detail.role
            && get(userPath(target)).data.role != d.detail.role)
          || (t == 'disabled_change' && d.detail.keys().hasOnly(['disabled']) && d.detail.disabled is bool
            && getAfter(userPath(target)).data.disabled == d.detail.disabled
            && get(userPath(target)).data.disabled != d.detail.disabled)
        );
    }

    function validLogCreate() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(logKeys())
        && d.keys().hasAll(logKeys())
        && d.actorUid == request.auth.uid
        && d.actorEmail == request.auth.token.get('email', null)
        && d.createdAt == request.time
        && (d.device == null || (d.device is string && d.device.size() <= 100))
        && d.detail is map
        && (validSelfLog(d) || validAdminLog(d));
    }

    match /auditLogs/{logId} {
      // 管理員看全部；一般使用者只能看自己做的事（個人資料頁的帳號活動）
      allow read: if isAdmin() || (signedIn() && resource.data.actorUid == request.auth.uid);
      allow create: if validLogCreate();
      allow update, delete: if false;
    }

    // 台股分析的投資組合（沿用原台股分析專案的規則）：只能存取自己的文件。
    // Email/密碼註冊的帳號要先驗證信箱才能讀寫。
    // 台股分析開放給所有登入的使用者；資料層面每個人只碰得到自己的持股（管理員也不例外）。
    match /portfolios/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId && emailVerifiedIfPassword();
    }

    // 台股損益存摺（HanDan）：手機端唯讀。
    // 資料由本機 serve.py 以服務帳戶寫入，服務帳戶會繞過安全規則，
    // 因此這裡把前端寫入一律擋掉，手機端即使憑證外流也只能讀不能改。
    // （2026-11-12 從 Firebase Console 的線上規則原樣併入，原本只存在 Console。）
    match /handan/{docId} {
      allow read: if request.auth != null
                  && request.auth.uid == '3U816AjRimMRL7l4x79Z6l2mFtx2';
      allow write: if false;
    }

    // 其他集合：全部拒絕（未比對到的路徑預設即拒絕，這裡明確寫出）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
